        "method": "DELETE",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $('New recording in Drive').item.json.id }}/permissions/{{ $('Add temporary anyone-reader link').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "supportsAllDrives",
              "value": "true"
            }
          ]
