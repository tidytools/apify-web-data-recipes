                "type": "string",
                "operation": "startsWith"
              }
            },
            {
              "id": "f2",
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "video/",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "a7e31c52-6d0b-4f1e-9c3a-2b8d4e6f0003",
      "name": "Transcript settings",
