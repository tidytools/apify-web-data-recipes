          "value": "kFhBWk7SCYTakF6Fn",
          "cachedResultName": "tidytools/website-contact-extractor",
          "cachedResultUrl": "https://console.apify.com/actors/kFhBWk7SCYTakF6Fn/input"
        },
        "customBody": "={\n  \"datasetId\": \"{{ $json.datasetId }}\",\n  \"datasetField\": \"{{ $json.websiteField }}\",\n  \"datasetKeepFields\": [\"title\", \"name\", \"placeId\", \"id\", \"categoryName\", \"category\", \"address\", \"city\", \"phone\", \"url\"],\n  \"onlyMissingEmail\": true,\n  \"requiredContact\": \"email\",\n  \"dedupeStoreName\": \"{{ $json.dedupeName }}\",\n  \"maxPagesPerSite\": 5\n}",
        "memory": 512,
        "maxTotalChargeUsd": 1
      }
    },
