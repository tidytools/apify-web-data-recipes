        "customBody": "={\n  \"searchStringsArray\": [\"{{ $json.searchTerm }}\"],\n  \"locationQuery\": \"{{ $json.location }}\",\n  \"maxCrawledPlacesPerSearch\": {{ $json.maxPlaces }},\n  \"language\": \"en\",\n  \"website\": \"allPlaces\",\n  \"scrapeContacts\": false,\n  \"scrapePlaceDetailPage\": false,\n  \"maxImages\": 0,\n  \"maxReviews\": 0,\n  \"maxQuestions\": 0\n}",
