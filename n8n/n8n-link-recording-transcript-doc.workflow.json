    {
      "parameters": {
        "jsCode": "// One stable id per recording: your sourceFileId, else the Dropbox file id (stays the same after renames and for\n// every new temporary link), else the presigned URL without its signature (bucket + object), else the URL.\nconst s = $('Transcript settings').first().json;\nconst dbx = $('Get Dropbox temporary link').isExecuted ? $('Get Dropbox temporary link').first().json : null;\nconst url = dbx ? dbx.link : s.url;\nif (!url) throw new Error('Send a \"url\" (presigned URL, Dropbox temporary link or any public file link) or a \"dropboxPath\"');\n// The Code node has no URL class, so the link is split with a regular expression.\nconst parts = url.match(/^([a-z][a-z0-9+.-]*:\\/\\/[^/?#]+)([^?#]*)(?:\\?([^#]*))?/i) || [];\nconst [, origin = '', pathname = '', query = ''] = parts;\nconst signed = query.split('&').some((q) => /^(x-amz-signature|x-goog-signature|signature|sig)$/i.test(q.split('=')[0]));\nconst stripped = signed ? `${origin}${pathname}` : url;\nconst sourceFileId = s.sourceFileId || (dbx ? `dropbox:${dbx.metadata.id}` : stripped);\n// Short key for Google Drive appProperties (key + value must stay under 124 bytes): cyrb53 hash of the id.\nconst cyrb53 = (str, seed = 0) => {\n  let h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;\n  for (let i = 0; i < str.length; i++) { const ch = str.charCodeAt(i); h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677); }\n  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);\n  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);\n  return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(36);\n};\nconst name = s.fileName || (dbx ? dbx.metadata.name : decodeURIComponent(pathname.split('/').pop() || 'recording'));\nreturn [{ json: { url, sourceFileId, sourceKey: `v1-${cyrb53(sourceFileId)}`, fileName: name, docTitle: `Transcript - ${name}` } }];"
      },
