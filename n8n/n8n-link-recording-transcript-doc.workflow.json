            {
              "id": "t1",
              "name": "docText",
              "type": "string",
              "value": "={{ (() => {\n  const j = $('Transcribe (any size, resumable)').item.json;\n  const pad = (n) => String(n).padStart(2, '0');\n  const clock = (s) => { s = Math.floor(s || 0); const h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60; return h ? `${h}:${pad(m)}:${pad(s % 60)}` : `${m}:${pad(s % 60)}`; };\n  const head = [\n    `Source: ${$('Source file id').item.json.fileName}`,\n    `Source file ID: ${j.sourceFileId || $('Source file id').item.json.sourceFileId}`,\n    `Apify run ID: ${j.runId || '-'}${j.reused ? ` (transcript reused from run ${j.reusedFromRunId}, not charged again)` : ''}`,\n    `Length: ${clock(j.durationSeconds)} (${j.billedMinutes} min billed)`,\n    j.language ? `Language: ${j.language}` : '',\n    j.speakers ? `Speakers: ${j.speakers}` : '',\n    `Files: TXT ${j.txtUrl || '-'} | Markdown ${j.mdUrl || '-'} | SRT ${j.srtUrl || '-'}`,\n  ].filter(Boolean).join('\\n');\n  const chapters = (j.chapters || []).map((c) => `${c.start} ${c.title}`).join('\\n');\n  const summary = j.summary ? `\\n\\nSUMMARY\\n${j.summary}${chapters ? `\\n\\nCHAPTERS\\n${chapters}` : ''}` : '';\n  const paras = j.paragraphs || [];\n  const body = paras.length ? paras.map((p) => `${p.speaker != null ? `Speaker ${p.speaker} ` : ''}[${clock(p.start)}] ${p.text}`).join('\\n\\n') : (j.text || '');\n  return `${head}${summary}\\n\\nTRANSCRIPT\\n\\n${body}\\n`;\n})() }}"
            },
