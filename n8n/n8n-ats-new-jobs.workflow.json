        "customBody": "={\n  \"companies\": {{ JSON.stringify($json.companies) }},\n  \"titleKeywords\": {{ JSON.stringify($json.titleKeywords) }},\n  \"onlyNewJobs\": true,\n  \"monitorName\": \"{{ $json.monitorName }}\",\n  \"descriptionFormat\": \"none\",\n  \"maxJobs\": 1000\n}",
        "memory": 1024,
